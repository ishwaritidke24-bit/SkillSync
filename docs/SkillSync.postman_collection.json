            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lead Full-Stack Architect\",\n  \"description\": \"Direct full-stack platform development and engineering standards.\",\n  \"requiredSkills\": [\n    \"TypeScript\",\n    \"Node.js\",\n    \"Next.js\",\n    \"MongoDB\",\n    \"Docker\"\n  ],\n  \"experienceMin\": 4,\n  \"experienceMax\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{jobId}}"]
